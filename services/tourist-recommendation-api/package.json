{
  "name": "tourist-recommendation-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/services/tourist-recommendation-api/src/server.js",
    "test": "vitest run",
